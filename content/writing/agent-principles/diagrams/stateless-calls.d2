...@_style
grid-columns: 2
grid-gap: 90
c1: 호출 1 {
  class: group
  direction: down
  in: 컨텍스트 c1 {class: box}
  out: 출력 y1 {class: box}
  in -> out
}
c2: 호출 2 {
  class: group
  direction: down
  in: 컨텍스트 c2 {class: box}
  out: 출력 y2 {class: box}
  in -> out
}
c1.out -> c2.in: "harness가 넣어 줄 때만" {style.stroke-dash: 3}
