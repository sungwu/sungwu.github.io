vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 0
    pad: 24
    theme-overrides: {
      B1: "#52525B"
      B2: "#71717A"
      B3: "#A1A1AA"
      B4: "#D4D4D8"
      B5: "#F4F4F5"
      B6: "#FAFAFA"
    }
  }
}
classes: {
  box: {
    style: {
      fill: "#FFFFFF"
      stroke: "#A1A1AA"
      stroke-width: 1
      border-radius: 8
      font-size: 15
      font-color: "#18181B"
    }
  }
  key: {
    style: {
      fill: "#EEF2FF"
      stroke: "#2F5BEA"
      stroke-width: 2
      border-radius: 8
      font-size: 15
      font-color: "#18181B"
      bold: true
    }
  }
  muted: {
    style: {
      fill: "#F4F4F5"
      stroke: "#D4D4D8"
      border-radius: 8
      font-size: 14
      font-color: "#52525B"
    }
  }
  group: {
    style: {
      fill: "#FAFAFA"
      stroke: "#D4D4D8"
      stroke-dash: 4
      border-radius: 12
      font-size: 15
      font-color: "#52525B"
      bold: true
    }
  }
  decision: {
    shape: hexagon
    style: {
      fill: "#FFFFFF"
      stroke: "#52525B"
      stroke-width: 1
      font-size: 14
      font-color: "#18181B"
    }
  }
}

